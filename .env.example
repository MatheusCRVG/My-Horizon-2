VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: own HTTPS web address. Native authentication uses myhorizon://auth/callback.
VITE_PUBLIC_APP_URL=http://localhost:5173
# Optional, web-only Google Drive backups (scope drive.file); never a client_secret.
VITE_GOOGLE_CLIENT_ID=

# Optional: HTTPS endpoint of your deployed price-search Worker, never its API key.
VITE_PRICE_SEARCH_ENDPOINT=
