{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Somente a janela local: envelopes cifrados, callbacks e abertura externa HTTPS.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    },
    "dialog:allow-save",
    "fs:allow-write-file",
    { "identifier": "fs:scope", "allow": [] },
    "allow-vault-storage"
  ]
}
